{
  "manifest_version": 3,
  "name": "mcp-hub 飞书文档读取",
  "version": "0.2.0",
  "description": "让本机 mcp-hub 读取你在浏览器里本来就能打开的飞书 / Lark 云文档（只读；禁止复制的文档不读）。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*",
    "https://*.larkoffice.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "mcp-hub 飞书文档读取", "default_popup": "options.html" },
  "options_page": "options.html"
}
