{
  "id": "feishu",
  "name": "飞书",
  "version": 1,
  "icon": "🪶",
  "summary": "以你本人的身份读写飞书消息、日程、任务、文档和多维表格 · 扫码自动建应用，不用找 IT",
  "tags": [
    "im",
    "office"
  ],
  "integration": "feishu",
  "helpUrl": "https://open.feishu.cn/",
  "baseUrl": "https://open.feishu.cn",
  "account": {
    "name": "name",
    "label": "飞书姓名",
    "placeholder": "张三",
    "help": "连接后自动填好，不用自己打"
  },
  "secret": {
    "name": "token",
    "label": "访问令牌",
    "help": "连接后由程序自己取、自己续"
  },
  "auth": {
    "kind": "bearer"
  },
  "fields": [
    {
      "name": "appId",
      "label": "App ID",
      "placeholder": "cli_xxxxxxxxxxxxxxxx",
      "help": "一键创建应用时自动填好。用 IT 建好的应用时，把它的 App ID 填在这里",
      "advanced": true
    }
  ],
  "oauth": {
    "flow": "device",
    "dialect": "feishu",
    "clientIdField": "appId",
    "clientSecret": {
      "name": "appSecret",
      "label": "App Secret",
      "help": "只存进本机系统密码管理器，不写配置文件"
    },
    "deviceCodeUrl": "https://accounts.feishu.cn/oauth/v1/device_authorization",
    "tokenUrl": "https://open.feishu.cn/open-apis/authen/v2/oauth/token",
    "registerUrl": "https://accounts.feishu.cn/oauth/v1/app/registration",
    "registerName": "MCP Hub（{user}）",
    "registerDesc": "让 Amazon Quick 以 {user} 本人的身份读写飞书消息",
    "scopes": [
      "im:message",
      "im:message.send_as_user",
      "im:message.group_msg:get_as_user",
      "im:message.p2p_msg:get_as_user",
      "im:chat:read",
      "search:message",
      "contact:user:search",
      "calendar:calendar.event:read",
      "calendar:calendar.event:create",
      "calendar:calendar.event:update",
      "calendar:calendar.event:reply",
      "calendar:calendar.free_busy:read",
      "task:task:read",
      "task:task:write",
      "task:comment:write",
      "search:docs:read",
      "docx:document:readonly",
      "wiki:wiki:readonly",
      "bitable:app:readonly",
      "bitable:app"
    ],
    "help": "第一次要扫两次码：先建应用，再授权。公司要求审批的话，等管理员通过后再点一次连接"
  },
  "postReads": true,
  "writeHelp": "打开后可以以你的名义发消息、回复消息，建日程、邀请参会人、回复日程邀请，建任务、完成任务、评论任务，以及新增和修改多维表格记录。默认关闭，关着时这些操作不会交给 AI",
  "failWhen": {
    "path": "code",
    "notEquals": 0,
    "messagePath": "msg"
  },
  "test": {
    "method": "GET",
    "path": "/open-apis/authen/v1/user_info",
    "result": {
      "path": "data",
      "fields": [
        "name",
        "open_id",
        "email",
        "tenant_key"
      ]
    }
  },
  "tools": [
    {
      "name": "feishu_whoami",
      "title": "当前飞书身份",
      "description": "确认现在以哪个飞书账号读写：返回姓名和 open_id。用户问「我是谁」、或者要给自己发消息需要自己的 open_id 时用它。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/authen/v1/user_info",
      "result": {
        "path": "data",
        "fields": [
          "name",
          "en_name",
          "open_id",
          "email"
        ]
      }
    },
    {
      "name": "feishu_list_chats",
      "title": "我的群",
      "description": "列出我所在的群聊，带 chat_id、群名和群描述。其它工具要的 chat_id 从这里或 feishu_search_chats 取，不要拿群名当 chat_id。知道群名的一部分时用 feishu_search_chats 更快；这个工具适合「我有哪些群」。has_more 为 true 时把 page_token 传回来翻下一页。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/im/v1/chats",
      "params": [
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "50",
          "description": "每页条数，最大 100"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记，取上一页结果里的 page_token"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "chat_id",
          "name",
          "description",
          "chat_mode",
          "external"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_search_chats",
      "title": "搜群",
      "description": "按关键词搜索我能看到的群聊，返回 chat_id 和群名。用户说「XX 群」时先用它拿 chat_id。结果里 <h>…</h> 是命中关键词的高亮标记。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/im/v2/chats/search",
      "params": [
        {
          "name": "query",
          "in": "body",
          "required": true,
          "description": "群名里的关键词"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "每页条数"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "meta_data.chat_id",
          "meta_data.name",
          "meta_data.description",
          "meta_data.external"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_get_messages",
      "title": "看聊天记录",
      "description": "读一个群聊或私聊的聊天记录，默认最新的在前，带发送人姓名、时间和内容。需要 chat_id：群聊从 feishu_search_chats 取，私聊从 feishu_search_user 结果里的 chat_id 取。body.content 是一段 JSON 文本，文字在其中的 text 或 content 里。消息带 thread_id 时，用 feishu_get_thread 看那条话题下面的讨论。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/im/v1/messages",
      "params": [
        {
          "name": "container_id",
          "in": "query",
          "required": true,
          "description": "会话的 chat_id（oc_ 开头）"
        },
        {
          "name": "container_id_type",
          "in": "query",
          "default": "chat",
          "enum": [
            "chat"
          ],
          "description": "固定为 chat"
        },
        {
          "name": "start_time",
          "in": "query",
          "description": "起始时间，秒级 Unix 时间戳"
        },
        {
          "name": "end_time",
          "in": "query",
          "description": "结束时间，秒级 Unix 时间戳"
        },
        {
          "name": "sort_type",
          "in": "query",
          "default": "ByCreateTimeDesc",
          "enum": [
            "ByCreateTimeDesc",
            "ByCreateTimeAsc"
          ],
          "description": "排序，默认最新的在前"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "每页条数，最大 50"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        },
        {
          "name": "with_sender_name",
          "in": "query",
          "type": "boolean",
          "default": "true",
          "description": "带上发送人姓名"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "message_id",
          "create_time",
          "msg_type",
          "sender.sender_name",
          "sender.id",
          "sender.sender_type",
          "body.content",
          "thread_id",
          "parent_id",
          "deleted"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_get_thread",
      "title": "看话题讨论",
      "description": "读一条消息下面的话题（thread）讨论。需要 thread_id，从 feishu_get_messages 结果里消息的 thread_id 取。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/im/v1/messages",
      "params": [
        {
          "name": "container_id",
          "in": "query",
          "required": true,
          "description": "话题的 thread_id（omt_ 开头）"
        },
        {
          "name": "container_id_type",
          "in": "query",
          "default": "thread",
          "enum": [
            "thread"
          ],
          "description": "固定为 thread"
        },
        {
          "name": "sort_type",
          "in": "query",
          "default": "ByCreateTimeAsc",
          "enum": [
            "ByCreateTimeDesc",
            "ByCreateTimeAsc"
          ],
          "description": "排序，默认按时间顺序"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "50",
          "description": "每页条数，最大 50"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        },
        {
          "name": "with_sender_name",
          "in": "query",
          "type": "boolean",
          "default": "true",
          "description": "带上发送人姓名"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "message_id",
          "create_time",
          "msg_type",
          "sender.sender_name",
          "sender.id",
          "body.content",
          "parent_id"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_search_messages",
      "title": "搜消息",
      "description": "跨所有群聊和私聊按关键词搜消息，返回每条的摘要（会话名 + 发送人 + 内容片段）、chat_id、message_id 和时间。摘要被截断、需要完整内容时，拿 message_id 调 feishu_get_message。<h>…</h> 是命中关键词的高亮标记。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/im/v1/messages/search",
      "params": [
        {
          "name": "query",
          "in": "body",
          "required": true,
          "description": "搜索关键词"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "每页条数，最大 50"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "display_info",
          "meta_data.message_id",
          "meta_data.chat_id",
          "meta_data.create_time",
          "meta_data.from_id",
          "meta_data.is_p2p_chat"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_get_message",
      "title": "读一条消息",
      "description": "按 message_id 读一条消息的完整内容和发送人。message_id 从 feishu_search_messages 或 feishu_get_messages 的结果里取。一次只读一条。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/im/v1/messages/mget",
      "params": [
        {
          "name": "message_ids",
          "in": "query",
          "required": true,
          "description": "消息的 message_id（om_ 开头），只能一个"
        },
        {
          "name": "with_sender_name",
          "in": "query",
          "type": "boolean",
          "default": "true",
          "description": "带上发送人姓名"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "message_id",
          "chat_id",
          "create_time",
          "msg_type",
          "sender.sender_name",
          "sender.id",
          "body.content",
          "thread_id",
          "parent_id"
        ]
      }
    },
    {
      "name": "feishu_search_user",
      "title": "找人",
      "description": "按姓名搜同事，返回 open_id、姓名，以及我和他的私聊 chat_id（聊过才有）。给某人发私聊要他的 open_id；看和他的私聊记录用 chat_id 调 feishu_get_messages。重名时把部门等信息给用户确认，不要自己挑一个。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/contact/v3/users/search",
      "params": [
        {
          "name": "query",
          "in": "body",
          "required": true,
          "description": "姓名或姓名的一部分"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "每页条数"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "id",
          "display_info",
          "meta_data.chat_id",
          "meta_data.i18n_names.zh_cn",
          "meta_data.enterprise_mail_address",
          "meta_data.is_cross_tenant"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_send_message",
      "title": "发消息",
      "description": "以我本人的身份发一条纯文本消息，对方看到的发送者是我，不是机器人。发群里：receive_id_type 填 chat_id、receive_id 填群的 chat_id；发私聊：receive_id_type 填 open_id、receive_id 填对方的 open_id（从 feishu_search_user 取）。发出后无法用这个工具撤回，发送前必须把发给谁和内容原文给用户确认。",
      "method": "POST",
      "path": "/open-apis/im/v1/messages",
      "params": [
        {
          "name": "receive_id_type",
          "in": "query",
          "required": true,
          "enum": [
            "chat_id",
            "open_id"
          ],
          "description": "chat_id＝发到群或已有会话；open_id＝私聊某人"
        },
        {
          "name": "receive_id",
          "in": "body",
          "required": true,
          "description": "群的 chat_id 或对方的 open_id，和 receive_id_type 对应"
        },
        {
          "name": "text",
          "in": "body",
          "bodyPath": "content.text",
          "required": true,
          "description": "消息正文，纯文本"
        }
      ],
      "bodyConst": {
        "msg_type": "text"
      },
      "bodyJsonString": [
        "content"
      ],
      "result": {
        "path": "data",
        "fields": [
          "message_id",
          "chat_id",
          "create_time",
          "sender.sender_type"
        ]
      }
    },
    {
      "name": "feishu_reply_message",
      "title": "回复消息",
      "description": "以我本人的身份回复某一条消息（纯文本）。需要那条消息的 message_id。reply_in_thread 为 true 时回复进话题，否则作为引用回复出现在会话里。发出后无法用这个工具撤回，发送前必须把回复内容给用户确认。",
      "method": "POST",
      "path": "/open-apis/im/v1/messages/{message_id}/reply",
      "params": [
        {
          "name": "message_id",
          "in": "path",
          "required": true,
          "description": "要回复的消息的 message_id（om_ 开头）"
        },
        {
          "name": "text",
          "in": "body",
          "bodyPath": "content.text",
          "required": true,
          "description": "回复正文，纯文本"
        },
        {
          "name": "reply_in_thread",
          "in": "body",
          "type": "boolean",
          "description": "是否回复进话题，默认否"
        }
      ],
      "bodyConst": {
        "msg_type": "text"
      },
      "bodyJsonString": [
        "content"
      ],
      "result": {
        "path": "data",
        "fields": [
          "message_id",
          "chat_id",
          "create_time",
          "thread_id",
          "sender.sender_type"
        ]
      }
    },
    {
      "name": "feishu_calendar_agenda",
      "title": "我的日程",
      "description": "列出我在一段时间内的日程（会议、安排），每条带 event_id、标题、开始和结束时间（秒级时间戳）、地点和视频会议链接。用户问「我明天有什么会」「下周的安排」时用它。时间范围不能超过 40 天。要看参会人和详情，拿 event_id 调 feishu_calendar_get_event。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/calendar/v4/calendars/primary/events/instance_view",
      "params": [
        {
          "name": "start_time",
          "in": "query",
          "required": true,
          "format": "unix",
          "description": "从什么时候开始"
        },
        {
          "name": "end_time",
          "in": "query",
          "required": true,
          "format": "unix",
          "description": "到什么时候结束"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "event_id",
          "summary",
          "start_time",
          "end_time",
          "location.name",
          "vchat.meeting_url",
          "status",
          "is_all_day",
          "organizer.display_name"
        ]
      }
    },
    {
      "name": "feishu_calendar_get_event",
      "title": "日程详情",
      "description": "读一个日程的完整信息：标题、描述、时间、地点、组织者、参会人及每个人是否接受。需要 event_id，从 feishu_calendar_agenda 的结果里取。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/calendar/v4/calendars/primary/events/{event_id}",
      "params": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "日程的 event_id"
        },
        {
          "name": "need_attendee",
          "in": "query",
          "type": "boolean",
          "default": "true",
          "description": "带上参会人"
        },
        {
          "name": "user_id_type",
          "in": "query",
          "default": "open_id",
          "enum": [
            "open_id"
          ],
          "description": "固定为 open_id"
        }
      ],
      "result": {
        "path": "data.event",
        "fields": [
          "event_id",
          "summary",
          "description",
          "start_time",
          "end_time",
          "location.name",
          "vchat.meeting_url",
          "event_organizer.display_name",
          "attendees",
          "app_link"
        ]
      }
    },
    {
      "name": "feishu_calendar_freebusy",
      "title": "查忙闲",
      "description": "查某个同事在一段时间内哪些时段忙，返回忙碌时段列表（不含日程内容）。约会议前用它找大家都有空的时间：对每个人各查一次，再找出空档。需要对方的 open_id，从 feishu_search_user 取；查自己用 feishu_whoami 的 open_id。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/calendar/v4/freebusy/list",
      "params": [
        {
          "name": "user_id",
          "in": "body",
          "required": true,
          "description": "要查的人的 open_id"
        },
        {
          "name": "time_min",
          "in": "body",
          "required": true,
          "format": "rfc3339",
          "description": "从什么时候开始"
        },
        {
          "name": "time_max",
          "in": "body",
          "required": true,
          "format": "rfc3339",
          "description": "到什么时候结束"
        },
        {
          "name": "user_id_type",
          "in": "query",
          "default": "open_id",
          "enum": [
            "open_id"
          ],
          "description": "固定为 open_id"
        }
      ],
      "result": {
        "path": "data.freebusy_list",
        "fields": [
          "start_time",
          "end_time"
        ]
      }
    },
    {
      "name": "feishu_calendar_create_event",
      "title": "建日程",
      "description": "在我的日历上建一个日程，返回 event_id。建好之后要邀请别人，拿 event_id 调 feishu_calendar_add_attendees。建之前必须把标题和时间给用户确认。",
      "method": "POST",
      "path": "/open-apis/calendar/v4/calendars/primary/events",
      "params": [
        {
          "name": "summary",
          "in": "body",
          "required": true,
          "description": "日程标题"
        },
        {
          "name": "start_time",
          "in": "body",
          "bodyPath": "start_time.timestamp",
          "required": true,
          "format": "unix",
          "description": "开始时间"
        },
        {
          "name": "end_time",
          "in": "body",
          "bodyPath": "end_time.timestamp",
          "required": true,
          "format": "unix",
          "description": "结束时间"
        },
        {
          "name": "description",
          "in": "body",
          "description": "日程描述，可选"
        }
      ],
      "result": {
        "path": "data.event",
        "fields": [
          "event_id",
          "summary",
          "start_time",
          "end_time",
          "app_link"
        ]
      }
    },
    {
      "name": "feishu_calendar_add_attendees",
      "title": "邀请参会人",
      "description": "把同事加进一个日程，他们会收到飞书邀请。需要日程的 event_id（feishu_calendar_create_event 或 feishu_calendar_agenda 的结果里取）和每个人的 open_id（feishu_search_user 取）。邀请之前必须把邀请谁给用户确认。",
      "method": "POST",
      "path": "/open-apis/calendar/v4/calendars/primary/events/{event_id}/attendees",
      "params": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "日程的 event_id"
        },
        {
          "name": "user_ids",
          "in": "body",
          "bodyPath": "attendees",
          "type": "array",
          "required": true,
          "itemObject": {
            "type": "user",
            "user_id": "{{item}}"
          },
          "description": "要邀请的人的 open_id 列表"
        },
        {
          "name": "user_id_type",
          "in": "query",
          "default": "open_id",
          "enum": [
            "open_id"
          ],
          "description": "固定为 open_id"
        }
      ],
      "bodyConst": {
        "need_notification": true
      },
      "result": {
        "path": "data.attendees",
        "fields": [
          "user_id",
          "display_name",
          "rsvp_status"
        ]
      }
    },
    {
      "name": "feishu_calendar_rsvp",
      "title": "回复日程邀请",
      "description": "以我的名义接受、拒绝或待定一个日程邀请，组织者会看到。需要 event_id。回复之前要和用户确认。",
      "method": "POST",
      "path": "/open-apis/calendar/v4/calendars/primary/events/{event_id}/reply",
      "params": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "日程的 event_id"
        },
        {
          "name": "rsvp_status",
          "in": "body",
          "required": true,
          "enum": [
            "accept",
            "decline",
            "tentative"
          ],
          "description": "accept 接受 / decline 拒绝 / tentative 待定"
        }
      ],
      "result": {}
    },
    {
      "name": "feishu_task_list",
      "title": "我的任务",
      "description": "列出分配给我的飞书任务，默认只列未完成的，每条带 guid、标题、截止时间（毫秒时间戳）和链接。用户问「我有哪些待办」时用它。has_more 为 true 时把 page_token 传回来翻页。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/task/v2/tasks",
      "params": [
        {
          "name": "completed",
          "in": "query",
          "type": "boolean",
          "default": "false",
          "description": "false 只看未完成，true 只看已完成"
        },
        {
          "name": "type",
          "in": "query",
          "default": "my_tasks",
          "enum": [
            "my_tasks"
          ],
          "description": "固定为 my_tasks"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "50",
          "description": "每页条数，最大 100"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        },
        {
          "name": "user_id_type",
          "in": "query",
          "default": "open_id",
          "enum": [
            "open_id"
          ],
          "description": "固定为 open_id"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "guid",
          "summary",
          "description",
          "due.timestamp",
          "due.is_all_day",
          "completed_at",
          "url"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_task_create",
      "title": "建任务",
      "description": "建一个飞书任务，可以指派给同事（他们会收到通知），返回 guid 和链接。不指派就是建给自己。负责人要 open_id，从 feishu_search_user 取。建之前必须把标题、负责人和截止时间给用户确认。",
      "method": "POST",
      "path": "/open-apis/task/v2/tasks",
      "params": [
        {
          "name": "summary",
          "in": "body",
          "required": true,
          "description": "任务标题"
        },
        {
          "name": "description",
          "in": "body",
          "description": "任务描述，可选"
        },
        {
          "name": "due",
          "in": "body",
          "bodyPath": "due.timestamp",
          "format": "unix_ms",
          "description": "截止时间，可选"
        },
        {
          "name": "assignees",
          "in": "body",
          "bodyPath": "members",
          "type": "array",
          "itemObject": {
            "id": "{{item}}",
            "type": "user",
            "role": "assignee"
          },
          "description": "负责人的 open_id 列表，可选"
        },
        {
          "name": "user_id_type",
          "in": "query",
          "default": "open_id",
          "enum": [
            "open_id"
          ],
          "description": "固定为 open_id"
        }
      ],
      "result": {
        "path": "data.task",
        "fields": [
          "guid",
          "summary",
          "due.timestamp",
          "url"
        ]
      }
    },
    {
      "name": "feishu_task_complete",
      "title": "完成任务",
      "description": "把一个任务标成已完成。需要任务的 guid，从 feishu_task_list 取。操作前要和用户确认是哪一个任务。",
      "method": "PATCH",
      "path": "/open-apis/task/v2/tasks/{task_guid}",
      "params": [
        {
          "name": "task_guid",
          "in": "path",
          "required": true,
          "description": "任务的 guid"
        }
      ],
      "bodyConst": {
        "task": {
          "completed_at": "{{now_ms}}"
        },
        "update_fields": [
          "completed_at"
        ]
      },
      "result": {
        "path": "data.task",
        "fields": [
          "guid",
          "summary",
          "completed_at",
          "url"
        ]
      }
    },
    {
      "name": "feishu_task_comment",
      "title": "评论任务",
      "description": "以我的名义在一个任务下面加评论，任务成员会看到。需要任务的 guid。发之前把评论内容给用户确认。",
      "method": "POST",
      "path": "/open-apis/task/v2/comments",
      "params": [
        {
          "name": "task_guid",
          "in": "body",
          "bodyPath": "resource_id",
          "required": true,
          "description": "任务的 guid"
        },
        {
          "name": "content",
          "in": "body",
          "required": true,
          "description": "评论内容，纯文本"
        }
      ],
      "bodyConst": {
        "resource_type": "task"
      },
      "result": {
        "path": "data.comment",
        "fields": [
          "id",
          "content",
          "created_at"
        ]
      }
    },
    {
      "name": "feishu_search_docs",
      "title": "搜文档",
      "description": "按关键词搜我能看到的飞书云文档和知识库页面，返回标题、类型、链接和更新时间。<h>…</h> 是命中关键词的高亮。要读正文：链接是 /docx/ 开头的，取链接最后一段当 document_id 调 feishu_read_doc；是 /wiki/ 开头的，先用 feishu_wiki_get_node 换出真正的文档 id。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/search/v2/doc_wiki/search",
      "params": [
        {
          "name": "query",
          "in": "body",
          "required": true,
          "description": "搜索关键词"
        },
        {
          "name": "page_size",
          "in": "body",
          "type": "number",
          "default": "15",
          "description": "每页条数，最大 20"
        },
        {
          "name": "page_token",
          "in": "body",
          "description": "翻页标记"
        }
      ],
      "bodyConst": {
        "doc_filter": {},
        "wiki_filter": {}
      },
      "result": {
        "path": "data.res_units",
        "fields": [
          "title_highlighted",
          "summary_highlighted",
          "entity_type",
          "result_meta.doc_types",
          "result_meta.url",
          "result_meta.token",
          "result_meta.update_time_iso",
          "result_meta.owner_name"
        ],
        "meta": [
          "data.has_more",
          "data.page_token",
          "data.total"
        ]
      }
    },
    {
      "name": "feishu_read_doc",
      "title": "读文档",
      "description": "读一篇飞书云文档（新版文档 docx）的纯文字正文，不含图片和格式。document_id 是文档链接 /docx/ 后面那一段；知识库链接（/wiki/）要先用 feishu_wiki_get_node 换出 obj_token。表格（sheet）和多维表格读不了，多维表格用 feishu_bitable_* 那几个工具。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/docx/v1/documents/{document_id}/raw_content",
      "params": [
        {
          "name": "document_id",
          "in": "path",
          "required": true,
          "description": "文档 id（链接 /docx/ 后面那一段）"
        }
      ],
      "result": {
        "path": "data",
        "fields": [
          "content"
        ]
      }
    },
    {
      "name": "feishu_wiki_get_node",
      "title": "打开知识库链接",
      "description": "把知识库链接（/wiki/ 后面那一段）换成它背后真正的东西：obj_type 是 docx 时拿 obj_token 调 feishu_read_doc；是 bitable 时 obj_token 就是多维表格的 app_token。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/wiki/v2/spaces/get_node",
      "params": [
        {
          "name": "token",
          "in": "query",
          "required": true,
          "description": "知识库链接 /wiki/ 后面那一段"
        }
      ],
      "result": {
        "path": "data.node",
        "fields": [
          "title",
          "obj_type",
          "obj_token",
          "node_token",
          "space_id",
          "has_child"
        ]
      }
    },
    {
      "name": "feishu_bitable_list_tables",
      "title": "多维表格里有哪些表",
      "description": "列出一个多维表格里的数据表，返回 table_id 和表名。app_token 是多维表格链接 /base/ 后面那一段（链接里的 ?table= 就是 table_id）；放在知识库里的多维表格，先用 feishu_wiki_get_node 换出 obj_token。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/bitable/v1/apps/{app_token}/tables",
      "params": [
        {
          "name": "app_token",
          "in": "path",
          "required": true,
          "description": "多维表格的 app_token"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "100",
          "description": "每页条数"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "table_id",
          "name"
        ],
        "meta": [
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_bitable_list_fields",
      "title": "看表的字段",
      "description": "列出一张数据表的字段（列）：字段名、类型，单选/多选字段还带可选项。查记录、加记录之前先用它弄清字段名和可选值，字段名必须一字不差。",
      "readOnly": true,
      "method": "GET",
      "path": "/open-apis/bitable/v1/apps/{app_token}/tables/{table_id}/fields",
      "params": [
        {
          "name": "app_token",
          "in": "path",
          "required": true,
          "description": "多维表格的 app_token"
        },
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "description": "数据表的 table_id"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "100",
          "description": "每页条数"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "field_id",
          "field_name",
          "ui_type",
          "is_primary",
          "property.options"
        ]
      }
    },
    {
      "name": "feishu_bitable_search_records",
      "title": "查表里的记录",
      "description": "查一张数据表里的记录，可以按条件筛选。filter 是飞书的筛选对象，例如 {\"conjunction\":\"and\",\"conditions\":[{\"field_name\":\"状态\",\"operator\":\"is\",\"value\":[\"未发货\"]}]}；operator 有 is、isNot、contains、doesNotContain、isEmpty、isNotEmpty、isGreater、isLess。不给 filter 就是全部记录。返回每条的 record_id 和字段值，total 是符合条件的总数，has_more 为 true 时用 page_token 翻页。",
      "readOnly": true,
      "method": "POST",
      "path": "/open-apis/bitable/v1/apps/{app_token}/tables/{table_id}/records/search",
      "params": [
        {
          "name": "app_token",
          "in": "path",
          "required": true,
          "description": "多维表格的 app_token"
        },
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "description": "数据表的 table_id"
        },
        {
          "name": "filter",
          "in": "body",
          "type": "object",
          "description": "筛选条件，可选"
        },
        {
          "name": "field_names",
          "in": "body",
          "type": "array",
          "description": "只返回这些字段，可选"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "number",
          "default": "50",
          "description": "每页条数，最大 500"
        },
        {
          "name": "page_token",
          "in": "query",
          "description": "翻页标记"
        }
      ],
      "result": {
        "path": "data.items",
        "fields": [
          "record_id",
          "fields"
        ],
        "meta": [
          "data.total",
          "data.has_more",
          "data.page_token"
        ]
      }
    },
    {
      "name": "feishu_bitable_create_record",
      "title": "加一条记录",
      "description": "在数据表里新增一行。fields 是「字段名 → 值」的对象，例如 {\"客户\":\"张三\",\"金额\":100,\"状态\":\"未发货\"}；字段名先用 feishu_bitable_list_fields 查准。加之前必须把要写的内容给用户确认。",
      "method": "POST",
      "path": "/open-apis/bitable/v1/apps/{app_token}/tables/{table_id}/records",
      "params": [
        {
          "name": "app_token",
          "in": "path",
          "required": true,
          "description": "多维表格的 app_token"
        },
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "description": "数据表的 table_id"
        },
        {
          "name": "fields",
          "in": "body",
          "type": "object",
          "required": true,
          "description": "字段名 → 值"
        }
      ],
      "result": {
        "path": "data.record",
        "fields": [
          "record_id",
          "fields"
        ]
      }
    },
    {
      "name": "feishu_bitable_update_record",
      "title": "改一条记录",
      "description": "修改数据表里的一行，只改 fields 里给出的字段，其余不变。需要 record_id，从 feishu_bitable_search_records 取。改之前必须把改哪一行、改成什么给用户确认。",
      "method": "PUT",
      "path": "/open-apis/bitable/v1/apps/{app_token}/tables/{table_id}/records/{record_id}",
      "params": [
        {
          "name": "app_token",
          "in": "path",
          "required": true,
          "description": "多维表格的 app_token"
        },
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "description": "数据表的 table_id"
        },
        {
          "name": "record_id",
          "in": "path",
          "required": true,
          "description": "记录的 record_id"
        },
        {
          "name": "fields",
          "in": "body",
          "type": "object",
          "required": true,
          "description": "要改的字段名 → 新值"
        }
      ],
      "result": {
        "path": "data.record",
        "fields": [
          "record_id",
          "fields"
        ]
      }
    }
  ]
}
