{
  "id": "github",
  "name": "GitHub",
  "version": 1,
  "icon": "🐙",
  "summary": "REST API · 个人访问令牌（PAT）",
  "tags": [
    "devtools",
    "project"
  ],
  "integration": "github",
  "helpUrl": "https://github.com/settings/tokens",
  "baseUrl": "https://api.github.com",
  "account": {
    "name": "login",
    "label": "GitHub 用户名",
    "placeholder": "octocat",
    "help": "只用来标识这份凭据存在哪个条目下；调接口用的身份由令牌本身决定"
  },
  "secret": {
    "name": "token",
    "label": "个人访问令牌 (PAT)",
    "help": "github.com → Settings → Developer settings → Personal access tokens。只读用途勾 public_repo / read:user 就够"
  },
  "auth": {
    "kind": "bearer"
  },
  "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
  },
  "test": {
    "method": "GET",
    "path": "/user",
    "result": {
      "fields": [
        "login",
        "name",
        "html_url"
      ]
    }
  },
  "tools": [
    {
      "name": "github_whoami",
      "title": "当前身份",
      "description": "确认现在在以谁的身份操作 GitHub：返回登录名、昵称和公开仓库数。不确定有没有权限、或者用户问「我是谁」时用它。",
      "readOnly": true,
      "method": "GET",
      "path": "/user",
      "result": {
        "fields": [
          "login",
          "name",
          "html_url",
          "public_repos"
        ]
      }
    },
    {
      "name": "github_list_my_repos",
      "title": "我的仓库",
      "description": "列出当前身份有权访问的仓库，默认按最近推送排序。用它回答「我有哪些仓库」「我最近在改哪个项目」。要找别人的仓库用 github_search_repos。",
      "readOnly": true,
      "method": "GET",
      "path": "/user/repos",
      "params": [
        {
          "name": "per_page",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "返回几个，最大 100"
        },
        {
          "name": "sort",
          "in": "query",
          "default": "pushed",
          "enum": [
            "created",
            "updated",
            "pushed",
            "full_name"
          ],
          "description": "排序方式"
        },
        {
          "name": "affiliation",
          "in": "query",
          "default": "owner,collaborator",
          "description": "仓库关系，逗号分隔：owner / collaborator / organization_member"
        }
      ],
      "result": {
        "limit": 50,
        "fields": [
          "full_name",
          "private",
          "description",
          "language",
          "pushed_at",
          "html_url",
          "open_issues_count"
        ]
      }
    },
    {
      "name": "github_search_repos",
      "title": "搜索仓库",
      "description": "在全站搜公开仓库，支持 GitHub 的搜索语法，例如 `mcp server language:go stars:>100`。用它找别人的项目；自己的仓库用 github_list_my_repos。",
      "readOnly": true,
      "method": "GET",
      "path": "/search/repositories",
      "params": [
        {
          "name": "q",
          "in": "query",
          "required": true,
          "description": "GitHub 搜索语法，可用 language: stars: pushed: 等限定词"
        },
        {
          "name": "sort",
          "in": "query",
          "enum": [
            "stars",
            "forks",
            "updated"
          ],
          "description": "排序字段，留空按相关度"
        },
        {
          "name": "per_page",
          "in": "query",
          "type": "number",
          "default": "10",
          "description": "返回几个，最大 100"
        }
      ],
      "result": {
        "path": "items",
        "limit": 30,
        "fields": [
          "full_name",
          "description",
          "language",
          "stargazers_count",
          "pushed_at",
          "html_url",
          "license.spdx_id"
        ]
      }
    },
    {
      "name": "github_list_issues",
      "title": "列出 Issue",
      "description": "列出一个仓库的 issue，返回编号、标题、状态、作者和链接，不含正文。GitHub 把 PR 也算作 issue，结果里带 pull_request 字段的那些是 PR。要看某条写了什么，拿编号调 github_get_issue。",
      "readOnly": true,
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues",
      "params": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "description": "仓库所属用户或组织"
        },
        {
          "name": "repo",
          "in": "path",
          "required": true,
          "description": "仓库名，不含所属前缀"
        },
        {
          "name": "state",
          "in": "query",
          "default": "open",
          "enum": [
            "open",
            "closed",
            "all"
          ],
          "description": "issue 状态"
        },
        {
          "name": "labels",
          "in": "query",
          "description": "按标签过滤，逗号分隔"
        },
        {
          "name": "per_page",
          "in": "query",
          "type": "number",
          "default": "20",
          "description": "返回几条，最大 100"
        }
      ],
      "result": {
        "limit": 50,
        "fields": [
          "number",
          "title",
          "state",
          "user.login",
          "comments",
          "created_at",
          "updated_at",
          "html_url"
        ]
      }
    },
    {
      "name": "github_get_issue",
      "title": "读取 Issue",
      "description": "读取一条 issue 或 PR 的正文和当前状态。编号从 github_list_issues 来，用户直接给了编号也可以。",
      "readOnly": true,
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues/{issue_number}",
      "params": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "description": "仓库所属用户或组织"
        },
        {
          "name": "repo",
          "in": "path",
          "required": true,
          "description": "仓库名"
        },
        {
          "name": "issue_number",
          "in": "path",
          "type": "number",
          "required": true,
          "description": "issue 或 PR 编号"
        }
      ],
      "result": {
        "fields": [
          "number",
          "title",
          "state",
          "user.login",
          "body",
          "comments",
          "created_at",
          "updated_at",
          "html_url"
        ]
      }
    },
    {
      "name": "github_create_issue",
      "title": "新建 Issue",
      "description": "在指定仓库新建一条 issue。这会在对方仓库留下公开记录，无法彻底删除，所以提交前应当把仓库、标题和正文给用户确认。",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/issues",
      "params": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "description": "仓库所属用户或组织"
        },
        {
          "name": "repo",
          "in": "path",
          "required": true,
          "description": "仓库名"
        },
        {
          "name": "title",
          "in": "body",
          "required": true,
          "description": "标题"
        },
        {
          "name": "body",
          "in": "body",
          "description": "正文，支持 Markdown"
        }
      ],
      "result": {
        "fields": [
          "number",
          "title",
          "state",
          "html_url"
        ]
      }
    }
  ]
}
