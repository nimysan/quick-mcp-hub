{
  "id": "k3cloud",
  "name": "金蝶云·星空",
  "version": 1,
  "icon": "📒",
  "summary": "K/3 Cloud WebAPI · 账号密码登录会话",
  "tags": [
    "erp",
    "finance"
  ],
  "integration": "k3cloud",
  "helpUrl": "https://open.kingdee.com/K3CloudDoc/",
  "baseUrlField": "site",
  "account": {
    "name": "username",
    "label": "金蝶账号",
    "placeholder": "integration_readonly",
    "help": "建议在星空里单建一个只分配查询权限的集成账号，不要用你本人的账号"
  },
  "secret": {
    "name": "password",
    "label": "账号密码",
    "help": "这是能登录 ERP 的真人密码，权限完全等于该账号在星空里的权限"
  },
  "fields": [
    {
      "name": "site",
      "label": "站点地址",
      "required": true,
      "placeholder": "https://你的域名/k3cloud",
      "help": "金蝶云·星空（K/3 Cloud）的服务地址，到 /k3cloud 为止，必须是 https。注意金蝶云·苍穹 / 星瀚 / 星辰 / KIS / K3 WISE 不是这套接口，填它们的地址连不上"
    },
    {
      "name": "acctId",
      "label": "账套 ID",
      "required": true,
      "help": "星空登录页或管理中心里能看到的数据中心 ID"
    }
  ],
  "auth": {
    "kind": "login",
    "login": {
      "path": "/Kingdee.BOS.WebApi.ServicesStub.AuthService.ValidateUser.common.kdsvc",
      "body": {
        "acctid": "{{field:acctId}}",
        "username": "{{account}}",
        "password": "{{secret}}",
        "lcid": 2052
      },
      "successPath": "LoginResultType",
      "successEquals": 1,
      "reloginOn": [
        "会话",
        "未登录",
        "重新登录",
        "session"
      ]
    }
  },
  "failWhen": {
    "path": "Result.ResponseStatus.IsSuccess",
    "equals": false,
    "messagePath": "Result.ResponseStatus.Errors"
  },
  "postReads": true,
  "tools": [
    {
      "name": "k3cloud_query_bill",
      "title": "查询单据",
      "description": "按金蝶的单据过滤语法查询任意单据的字段值。formId 是表单标识（物料 BD_MATERIAL、客户 BD_Customer、销售订单 SAL_SaleOrder、采购订单 PUR_PurchaseOrder、应收单 AR_receivable）。fieldKeys 决定返回哪些列，必须明确列出——这个接口不支持「返回全部字段」。",
      "readOnly": true,
      "method": "POST",
      "path": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.ExecuteBillQuery.common.kdsvc",
      "params": [
        {
          "name": "formId",
          "in": "body",
          "bodyPath": "data.FormId",
          "required": true,
          "description": "表单标识，如 BD_MATERIAL / SAL_SaleOrder"
        },
        {
          "name": "fieldKeys",
          "in": "body",
          "bodyPath": "data.FieldKeys",
          "required": true,
          "description": "要查的字段，逗号分隔，如 FNumber,FName,FCreateDate；单据体字段用 FEntity_FField 形式"
        },
        {
          "name": "filterString",
          "in": "body",
          "bodyPath": "data.FilterString",
          "description": "过滤条件，SQL where 的写法，如 FNumber='001' and FCreateDate>='2026-01-01'"
        },
        {
          "name": "orderString",
          "in": "body",
          "bodyPath": "data.OrderString",
          "description": "排序，如 FCreateDate desc"
        },
        {
          "name": "limit",
          "in": "body",
          "bodyPath": "data.Limit",
          "type": "number",
          "default": "20",
          "description": "返回条数，建议不超过 200"
        },
        {
          "name": "startRow",
          "in": "body",
          "bodyPath": "data.StartRow",
          "type": "number",
          "default": "0",
          "description": "从第几行开始，用于翻页"
        }
      ],
      "result": {
        "limit": 200,
        "columnsFromParam": "fieldKeys"
      }
    },
    {
      "name": "k3cloud_view_bill",
      "title": "读取单据详情",
      "description": "按编码或内码读取一张单据的完整数据。number 和 id 给一个即可，编码更常用。要先知道有哪些单据用 k3cloud_query_bill。",
      "readOnly": true,
      "method": "POST",
      "path": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.View.common.kdsvc",
      "params": [
        {
          "name": "formId",
          "in": "body",
          "bodyPath": "formid",
          "required": true,
          "description": "表单标识，如 BD_MATERIAL"
        },
        {
          "name": "number",
          "in": "body",
          "bodyPath": "data.Number",
          "description": "单据编码"
        },
        {
          "name": "id",
          "in": "body",
          "bodyPath": "data.Id",
          "description": "单据内码，和编码给一个就行"
        },
        {
          "name": "createOrgId",
          "in": "body",
          "bodyPath": "data.CreateOrgId",
          "type": "number",
          "default": "0",
          "description": "创建组织内码，0 表示不限"
        }
      ]
    },
    {
      "name": "k3cloud_save_bill",
      "title": "保存单据",
      "description": "新增或修改一张单据。model 是单据的完整数据对象，字段名用金蝶的标识（如 {\"FNumber\":\"001\",\"FName\":{\"FLocaleId\":2052,\"FValue\":\"测试\"}}）。这会真的写进 ERP：保存后的单据会出现在对方的业务流程里，撤销要走业务删除。",
      "method": "POST",
      "path": "/Kingdee.BOS.WebApi.ServicesStub.DynamicFormService.Save.common.kdsvc",
      "params": [
        {
          "name": "formId",
          "in": "body",
          "bodyPath": "formid",
          "required": true,
          "description": "表单标识"
        },
        {
          "name": "model",
          "in": "body",
          "bodyPath": "data.Model",
          "type": "object",
          "required": true,
          "description": "单据数据对象，键名是金蝶字段标识"
        },
        {
          "name": "needUpDateFields",
          "in": "body",
          "bodyPath": "data.NeedUpDateFields",
          "description": "修改时只更新这些字段，逗号分隔；新增留空"
        }
      ]
    }
  ]
}
